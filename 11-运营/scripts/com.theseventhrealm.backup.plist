<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.theseventhrealm.backup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/PATH/TO/11-运营/scripts/backup-pull.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>REPO_URL</key>
    <string>git@github.com:YOUR_NAME/YOUR_REPO.git</string>
    <key>BACKUP_ROOT</key>
    <string>/Volumes/YOUR_DISK/第七境备份</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/theseventhrealm-backup.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/theseventhrealm-backup.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
