{"id":32,"slug":"5000years","content":{"raw":"<!-- wp:html -->\n<style>\n\/* ===== WordPress \u4e3b\u9898\u95f4\u8ddd\/\u9650\u5bbd\u4fee\u6b63\uff1a\u4f7f\u672c\u9875\u5bfc\u822a\u8d34\u9876\u3001\u901a\u680f\u94fa\u6ee1\u4e0e\u5404\u9875\u5bf9\u9f50 ===== *\/\nmain.wp-block-group{margin-top:0!important;padding-top:0!important}\n.wp-block-group.has-global-padding{padding-top:0!important}\n.entry-content{margin-top:0!important}\n.entry-content.has-global-padding{padding-top:0!important}\n.entry-content.alignfull{padding-left:0!important;padding-right:0!important}\n.entry-content.alignfull > *{max-width:none!important;margin-left:0!important;margin-right:0!important}\n.brand{margin-top:0!important}\nnav{margin-top:0!important}\n<\/style>\n<style>\n@import url('https:\/\/fonts.loli.net\/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600&display=swap');\n\n:root{\n  --white:#ffffff;\n  --ink:#1a1a18;\n  --ink2:#6b675f;\n  --ink-light:rgba(26,26,24,.05);\n  --cinnabar:#b03826;\n  --f-brush:'Ma Shan Zheng','Xingkai SC','STXingkai','KaiTi','STKaiti',serif;\n  --f-body:'Noto Serif SC','Songti SC','STSong','KaiTi','STKaiti',serif;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  background:var(--white);\n  color:var(--ink);\n  font-family:var(--f-body);\n  overflow-x:hidden;\n  line-height:2.1;\n  text-align:center;\n}\n::selection{background:var(--ink);color:#fff}\na{color:inherit;text-decoration:none}\n\n\/* ---------- \u58a8\u5c18 ---------- *\/\n.dust{position:fixed;z-index:-1;border-radius:50%;pointer-events:none;\n  background:radial-gradient(circle, rgba(26,26,24,.16), transparent 70%);\n  animation:drift linear infinite;opacity:0}\n@keyframes drift{\n  0%{transform:translate(0,0);opacity:0}\n  15%{opacity:.35}\n  100%{transform:translate(30px,-108vh) scale(.4);opacity:0}\n}\n\n\/* ---------- \u54c1\u724c Logo \u533a ---------- *\/\n.brand{padding:0 0 14px;text-align:center}\n.brand a{\n  display:block;width:100%;max-width:none;margin:0 auto\n}\n.brand .logo-img{display:block;width:100%;height:auto}\n\n\/* ---------- \u9876\u90e8\u5bfc\u822a\uff08\u7c98\u6027\u56fa\u5b9a\uff09 ---------- *\/\nnav{\n  position:sticky;top:var(--wp-admin--admin-bar--height,0);z-index:50;\n  width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);\n  padding:16px 16px 12px;text-align:center;\n  background:rgba(255,255,255,.94);\n  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);\n  border-bottom:1px solid rgba(26,26,24,.16);\n  border-top:1px solid rgba(26,26,24,.16)\n}\nnav a{\n  font-family:var(--f-brush);\n  font-size:clamp(16px,2.2vw,19px);letter-spacing:5px;\n  margin:0 clamp(8px,1.8vw,16px);color:var(--ink);\n  padding-bottom:4px;border-bottom:2px solid transparent;\n  transition:color .3s,border-color .3s\n}\nnav a:hover{color:var(--cinnabar)}\nnav a.here{color:var(--cinnabar);border-bottom-color:var(--cinnabar)}\nnav a.todo{color:rgba(26,26,24,.38)}\nnav a.todo:hover{color:var(--ink2)}\nnav a.todo::after{content:\"\u672a\u542f\";font-size:10px;letter-spacing:1px;color:var(--cinnabar);\n  vertical-align:super;margin-left:2px;font-family:var(--f-body)}\n\n\/* ---------- \u901a\u7528 ---------- *\/\nsection{padding:80px 24px;position:relative}\n.reveal{opacity:0;transform:translateY(26px);transition:opacity 1.2s ease,transform 1.2s ease}\n.reveal.in{opacity:1;transform:none}\n.brush{width:min(200px,48%);height:14px;margin:14px auto 38px;display:block}\n.brush path{fill:var(--ink)}\n\n\/* ---------- \u4e3b\u89c6\u89c9 ---------- *\/\n.hero{min-height:74vh;display:flex;flex-direction:column;justify-content:center;padding:50px 24px}\n.hero .zi-top{font-size:clamp(14px,2vw,17px);letter-spacing:9px;padding-left:9px;color:var(--ink2);margin-bottom:8px}\n.hero h1{\n  font-family:var(--f-brush);font-weight:400;\n  font-size:clamp(50px,8.5vw,86px);line-height:1.25;\n  letter-spacing:.08em;text-indent:.08em;color:var(--ink);\n}\n.hero .subtitle{margin-top:14px;font-size:clamp(16px,2.3vw,20px);letter-spacing:10px;color:var(--ink2)}\n.hero .seal{\n  margin-top:28px;display:inline-block;\n  background:var(--cinnabar);color:#fff;\n  font-family:var(--f-brush);\n  padding:7px 14px;font-size:14px;letter-spacing:6px;border-radius:2px;\n  box-shadow:0 4px 14px rgba(176,56,38,.28);\n  animation:fadeUp 1.1s ease 1.3s forwards;opacity:0\n}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\n.scroll-hint{\n  display:block;margin-top:48px;\n  font-size:12px;letter-spacing:6px;color:rgba(26,26,24,.35);\n  animation:bob 2.2s ease-in-out infinite\n}\n@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}\n\n\/* ---------- \u65f6\u95f4\u957f\u5377 ---------- *\/\n.timeline{position:relative;max-width:760px;margin:0 auto;padding:30px 0 10px}\n.timeline::before{\n  content:\"\";position:absolute;left:50%;top:0;bottom:0;width:2px;\n  transform:translateX(-50%);\n  background:linear-gradient(180deg, transparent, rgba(26,26,24,.28) 6%, rgba(26,26,24,.28) 94%, transparent)\n}\n.era{position:relative;padding:34px 0 46px}\n.era::before{\n  content:\"\";position:absolute;left:50%;top:64px;transform:translateX(-50%);\n  width:11px;height:11px;border-radius:50%;background:var(--ink);\n  box-shadow:0 0 0 5px rgba(26,26,24,.08)\n}\n.era.red::before{background:var(--cinnabar);box-shadow:0 0 0 5px rgba(176,56,38,.12)}\n.era .years{\n  font-size:clamp(12px,1.8vw,14px);letter-spacing:4px;color:var(--ink2);\n  margin-bottom:2px\n}\n.era h3{\n  font-family:var(--f-brush);font-weight:400;\n  font-size:clamp(30px,4.6vw,44px);letter-spacing:14px;padding-left:14px;\n  color:var(--ink);line-height:1.5\n}\n.era h3 em{font-style:normal;color:var(--cinnabar)}\n.era .word{\n  font-size:clamp(15px,2.2vw,18px);letter-spacing:5px;color:var(--ink2);margin-top:6px\n}\n.era .note{\n  max-width:560px;margin:10px auto 0;\n  font-size:clamp(14px,2vw,16px);letter-spacing:2px;color:var(--ink2);\n  text-align:justify;text-align-last:center\n}\n.era .ghost{\n  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);\n  font-family:var(--f-brush);font-size:clamp(110px,18vw,190px);\n  color:var(--ink-light);pointer-events:none;user-select:none;z-index:-1;white-space:nowrap\n}\n\n\/* ---------- \u5377\u5c3e ---------- *\/\n.finale{padding:40px 24px 20px}\n.final-line{\n  font-family:var(--f-brush);\n  font-size:clamp(28px,4.5vw,42px);letter-spacing:10px;color:var(--ink)\n}\n.final-line b{font-weight:400;color:var(--cinnabar)}\n.back-home{\n  display:inline-block;margin-top:36px;\n  font-family:var(--f-brush);\n  font-size:clamp(17px,2.4vw,20px);letter-spacing:6px;color:var(--ink);\n  padding-bottom:4px;border-bottom:2px solid rgba(26,26,24,.35);\n  transition:color .3s,border-color .3s\n}\n.back-home:hover{color:var(--cinnabar);border-bottom-color:var(--cinnabar)}\n\nfooter{padding:60px 24px;text-align:center;font-size:13px;letter-spacing:4px;color:var(--ink2)}\nfooter .tg{letter-spacing:14px;display:block;margin-bottom:12px;color:rgba(26,26,24,.35)}\nfooter .f-links{margin-top:24px;display:flex;justify-content:center;align-items:center;gap:20px;\n  font-family:var(--f-brush);font-size:15px;letter-spacing:3px}\nfooter .f-links a{color:var(--ink2);transition:color .3s}\nfooter .f-links a:hover{color:var(--cinnabar)}\nfooter .f-links .sep{font-size:9px;color:rgba(26,26,24,.25)}\nfooter .cp{margin-top:16px;font-size:11px;letter-spacing:2.5px;color:rgba(26,26,24,.38)}\nfooter .legal{margin-top:8px;font-size:10.5px;letter-spacing:1.5px;color:rgba(26,26,24,.32);line-height:2}\nfooter .legal a{color:rgba(26,26,24,.45);text-decoration:underline;text-underline-offset:3px}\nfooter .legal a:hover{color:var(--cinnabar)}\n<\/style>\n\n<div class=\"brand\">\n  <a href=\"\/\" aria-label=\"\u7b2c\u4e03\u5883 \u00b7 \u9996\u9875\">\n    <img class=\"logo-img\" src=\"http:\/\/theseventhrealm.com\/wp-content\/uploads\/2026\/09\/logo-banner.png\" alt=\"\u7b2c\u4e03\u5883 \u00b7 \u9876\u90e8\u