{"id":13,"slug":"13-2","content":{"raw":"<!-- wp:columns {\"align\":\"full\"} -->\n<div class=\"wp-block-columns alignfull\"><!-- wp:column {\"width\":\"100%\"} -->\n<div class=\"wp-block-column\" style=\"flex-basis:100%\"><!-- wp:html -->\n<style>\n@import url('https:\/\/fonts.loli.net\/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600&display=swap');\n\n:root{\n  --white:#ffffff;\n  --ink:#1a1a18;\n  --ink2:#6b675f;\n  --ink-light:rgba(26,26,24,.05);\n  --cinnabar:#b03826;\n  --f-brush:'Ma Shan Zheng','Xingkai SC','STXingkai','KaiTi','STKaiti',serif;\n  --f-body:'Noto Serif SC','Songti SC','STSong','KaiTi','STKaiti',serif;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  background:var(--white);\n  color:var(--ink);\n  font-family:var(--f-body);\n  overflow-x:hidden;\n  line-height:2.1;\n  text-align:center;\n}\n::selection{background:var(--ink);color:#fff}\n\n\/* ---------- \u58a8\u5c18\uff08\u6781\u6de1\uff09 ---------- *\/\n.dust{position:fixed;z-index:-1;border-radius:50%;pointer-events:none;\n  background:radial-gradient(circle, rgba(26,26,24,.16), transparent 70%);\n  animation:drift linear infinite;opacity:0}\n@keyframes drift{\n  0%{transform:translate(0,0);opacity:0}\n  15%{opacity:.35}\n  100%{transform:translate(30px,-108vh) scale(.4);opacity:0}\n}\n\n\/* ---------- \u901a\u7528\uff1a\u5168\u90e8\u5c45\u4e2d ---------- *\/\n.wrap{max-width:840px;margin:0 auto;padding:0 24px}\nsection{padding:88px 24px;position:relative}\n.reveal{opacity:0;transform:translateY(26px);transition:opacity 1.2s ease,transform 1.2s ease}\n.reveal.in{opacity:1;transform:none}\n\n\/* \u6bdb\u7b14\u6a2a\u7ebf\uff08\u975e\u5916\u6846\uff0c\u4ec5\u5206\u9694\uff09 *\/\n.brush{width:min(200px,48%);height:14px;margin:14px auto 38px;display:block}\n.brush path{fill:var(--ink)}\n.trigram{font-size:13px;letter-spacing:15px;padding-left:15px;\n  color:rgba(26,26,24,.3);display:block;margin-bottom:34px}\n\n\/* \u5b57\u53f7\u4f53\u7cfb\uff1a\u6807\u9898\u4e0e\u6b63\u6587\u5dee\u8ddd\u6536\u655b *\/\nh2{font-family:var(--f-brush);font-weight:400;font-size:clamp(27px,3.6vw,34px);letter-spacing:12px;color:var(--ink)}\n\n\/* ---------- \u4e3b\u89c6\u89c9 ---------- *\/\n.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;padding:60px 24px}\n.hero .zi-top{font-size:clamp(14px,2vw,17px);letter-spacing:9px;padding-left:9px;color:var(--ink2);margin-bottom:8px}\n.hero h1{\n  font-family:var(--f-brush);font-weight:400;\n  font-size:clamp(54px,9vw,92px);line-height:1.25;\n  letter-spacing:.08em;text-indent:.08em;color:var(--ink);\n}\n.hero .subtitle{margin-top:14px;font-size:clamp(16px,2.3vw,20px);letter-spacing:10px;color:var(--ink2)}\n.hero .subtitle span{margin:0 10px;opacity:0;animation:fadeUp 1.1s ease forwards}\n.hero .subtitle span:nth-child(1){animation-delay:.4s}\n.hero .subtitle span:nth-child(2){animation-delay:.9s}\n.hero .seal{\n  margin-top:30px;display:inline-block;\n  background:var(--cinnabar);color:#fff;\n  font-family:var(--f-brush);\n  padding:7px 14px;font-size:14px;letter-spacing:6px;border-radius:2px;\n  box-shadow:0 4px 14px rgba(176,56,38,.28);\n  animation:fadeUp 1.1s ease 1.5s forwards;opacity:0\n}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\n.scroll-hint{\n  display:block;margin-top:52px;\n  font-size:12px;letter-spacing:6px;color:rgba(26,26,24,.35);\n  animation:bob 2.2s ease-in-out infinite\n}\n@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}\n\n\/* ---------- \u8bd7\u7bc7\uff1a\u7ad6\u6392\u5c45\u4e2d ---------- *\/\n.vpoem{display:flex;justify-content:center;align-items:flex-start;gap:clamp(20px,4vw,42px)}\n.vpoem p{\n  writing-mode:vertical-rl;\n  font-family:var(--f-brush);\n  font-size:clamp(19px,2.8vw,25px);letter-spacing:12px;\n  color:var(--ink);line-height:1\n}\n.vpoem p em{font-style:normal;color:var(--cinnabar)}\n.verse .ghost{\n  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n  font-family:var(--f-brush);\n  font-size:clamp(150px,24vw,280px);color:var(--ink-light);\n  pointer-events:none;user-select:none;z-index:-1\n}\n.book-tag{\n  display:inline-block;margin-bottom:32px;\n  font-family:var(--f-brush);\n  font-size:clamp(22px,3vw,28px);letter-spacing:12px;padding-left:12px;color:var(--ink)\n}\n\n@media(max-width:640px){\n  .vpoem{flex-direction:column;align-items:center;gap:4px}\n  .vpoem p{writing-mode:horizontal-tb;letter-spacing:6px;line-height:2.1}\n}\n\n\/* ---------- \u4e09\u91ca\uff1a\u5c45\u4e2d\u4e09\u67f1 ---------- *\/\n.sanshi{display:flex;justify-content:center;align-items:flex-start;gap:clamp(36px,9vw,100px);margin-top:26px}\n.sanshi .col{display:flex;flex-direction:column;align-items:center;gap:18px}\n.sanshi .zi{\n  width:72px;height:72px;display:flex;align-items:center;justify-content:center;\n  font-family:var(--f-brush);font-size:42px;color:#fff;\n  background:var(--ink);border-radius:4px;\n  box-shadow:0 8px 22px rgba(26,26,24,.22)\n}\n.sanshi .col.red .zi{background:var(--cinnabar);box-shadow:0 8px 22px rgba(176,56,38,.26)}\n.sanshi .desc{font-size:clamp(17px,2.3vw,20px);letter-spacing:6px;color:var(--ink)}\n.sanshi .en{font-size:12px;letter-spacing:2px;color:var(--ink2)}\n@media(max-width:640px){\n  .sanshi{flex-direction:column;align-items:center;gap:40px}\n}\n\n\/* ---------- \u72ec\u53e5 ---------- *\/\n.lone{font-family:var(--f-brush);font-size:clamp(26px,3.8vw,36px);letter-spacing:10px;line-height:2}\n.lone em{font-style:normal;color:var(--cinnabar)}\n\n\/* ---------- \u5b8f\u6587 ---------- *\/\n.prose{max-width:680px;margin:0 auto}\n.prose p{font-size:clamp(17px,2.4vw,20px);letter-spacing:3px;margin:22px 0;color:var(--ink)}\n.prose strong{color:var(--cinnabar);font-weight:600}\n\n\/* ---------- \u7ec8\u7ae0\uff1a\u65e0\u5916\u6846\uff0c\u7559\u767d\u5c45\u4e2d ---------- *\/\n.finale{padding:24px 0 10px}\n.finale .list{font-size:clamp(17px,2.5vw,21px);letter-spacing:4px;line-height:2.6}\n.finale .money{margin-top:18px;color:var(--ink2);font-size:clamp(15px,2.2vw,18px);letter-spacing:4px}\n.final-line{\n  margin-top:30px;font-family:var(--f-brush);\n  font-size:clamp(30px,4.5vw,42px);letter-spacing:10px;color:var(--ink)\n}\n.final-line b{font-weight:400;color:var(--cinnabar)}\n\nfooter{padding:70px 24px 60px;text-align:center;font-size:13px;letter-spacing:4px;color:var(--ink2)}\nfooter .tg{letter-spacing:14px;display:block;margin-bottom:12px;color:rgba(26,26,24,.35)}\n<\/style>\n\n<header class=\"hero\">\n  <p class=\"zi-top\">\u9053 \u751f \u4e00 \u00b7 \u4e00 \u751f \u4e8c \u00b7 \u4e8c \u751f \u4e09 \u00b7 \u4e09 \u751f \u4e07 \u7269<\/p>\n  <h1>\u9053\u5883<\/h1>\n  <p class=\"subtitle\"><span>\u5929\u9053\u916c\u52e4<\/span><span>\u9053\u6cd5\u81ea\u7136<\/span><\/p>\n  <div><span class=\"seal\">\u4e03\u5883\u4e4b\u5370<\/span><\/div>\n  <span class=\"scroll-hint\">\u5c55 \u5377<\/span>\n<\/header>\n\n<section class=\"verse reveal\">\n  <span class=\"trigram\">\u2630 \u2631 \u2632 \u2633 \u2634 \u2635 \u2636 \u2637<\/span>\n  <div class=\"vpoem\">\n    <p>\u9053\u82e5\u4e0d\u540c\uff0c\u4e0d\u76f8\u4e3a\u8c0b\u3002<\/p>\n    <p>\u4e03\u5883\u4e4b\u5185\uff0c\u7686\u4e3a\u543e\u8f88\u3002<\/p>\n    <p>\u4e03\u5883\u4e4b\u5916\uff0c\u540c\u4ec7\u654c\u5ffe\u3002<\/p>\n  <\/div>\n  <span class=\"ghost\">\u9053<\/span>\n<\/section>\n\n<section class=\"verse reveal\">\n  <div class=\"book-tag\">\u5723\u7ecf<\/div>\n  <div class=\"vpoem\">\n    <p>\u795e\u4e0d\u7231\u4e16\u4eba\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u7231<\/em>\u3002<\/p>\n    <p>\u795e\u4e0d\u60af\u4e16\u4eba\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u601c<\/em>\u3002<\/p>\n    <p>\u795e\u4e0d\u5b58\u5f53\u4e16\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u4fe1<\/em>\u3002<\/p>\n    <p>\u795e\u975e\u6551\u4e16\u4e3b\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u6551<\/em>\u3002<\/p>\n  <\/div>\n  <span class=\"ghost\">\u795e<\/span>\n<\/section>\n\n<section class=\"reveal\">\n  <h2>\u4e09\u91ca<\/h2>\n  <svg class=\"brush\" viewBox=\"0 0 200 14\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    <path d=\"M3 8 C 26 5, 52 11, 84 8 C 126 4, 160 10, 197 7 C 168 12, 126 14, 92 11 C 58 9, 26 12, 3 8 Z\"\/>\n  <\/svg>\n  <div class=\"sanshi\">\n    <div class=\"col\">\n      <div class=\"zi\">\u9053<\/div>\n      <p class=\"desc\">\u662f\u81ea\u7136\u4e4b\u6cd5<\/p>\n      <span class=\"en\">THE LAW OF NATURE<\/span>\n    <\/div>\n    <div class=\"col\">\n      <div class=\"zi\">\u6cd5<\/div>\n      <p class=\"desc\">\u662f\u9053\u5fb7\u4e4b\u7ebf<\/p>\n      <span class=\"en\">THE THREAD OF VIRTUE<\/span>\n    <\/div>\n    <div class=\"col red\">\n      <div class=\"zi\">\u795e<\/div>\n      <p class=\"desc\">\u662f\u65e0\u77e5\u4e4b\u4ef0<\/p>\n      <span class=\"en\">THE FAITH OF IGNORANCE<\/span>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"reveal\">\n  <span class=\"trigram\">\u2630 \u2631 \u2632 \u2633 \u2634 \u2635 \u2636 \u2637<\/span>\n  <p class=\"lone\">\u89c1\u5929\u5730\uff0c\u89c1\u4f17\u751f\uff0c<br>\u552f<em>\u4e0d\u89c1\u795e\u8ff9<\/em>\u3002<\/p>\n<\/section>\n\n<section class=\"reveal\">\n  <div class=\"prose\">\n    <p>\u534e\u590f\u4e94\u5343\u5e74\u6587\u660e\u751f\u751f\u4e0d\u606f\uff0c\u5168\u9760\u4f17\u751f\u3002\u4ece\u65e0\u795e\u663e\u2014\u2014\u751f\u6b7b\u6709\u547d\uff0c\u4eba\u5b9a\u80dc\u5929\uff1b\u5929\u9053\u8f6e\u56de\uff0c\u6b7b\u800c\u590d\u751f\uff0c\u4e0d\u751f\u4e0d\u706d\uff0c\u662f\u4e3a<strong>\u6c38\u751f<\/strong>\u3002<\/p>\n    <p>\u6545\u800c\u6c38\u751f\u4e4b\u6cd5\u4e0d\u5728\u8089\u8eab\uff0c\u5728<strong>\u6587\u660e\u4e4b\u7075\u7684\u4f20\u627f<\/strong>\u3002\u89c9\u9192\u4e4b\u65e5\uff0c\u4fbf\u662f\u609f\u9053\u4e4b\u65f6\u3002<\/p>\n  <\/div>\n<\/section>\n\n<section class=\"reveal\">\n  <div class=\"finale\">\n    <div class=\"list\">\n      \u597d\u597d\u6d3b\u7740\uff0c\u597d\u597d\u594b\u6597\uff0c\u597d\u597d\u604b\u7231\uff0c<br>\n      \u597d\u597d\u751f\u80b2\uff0c\u597d\u597d\u6559\u80b2\u4e0b\u4e00\u4ee3\uff0c<br>\n      \u597d\u597d\u4f20\u627f\uff0c\u597d\u597d\u4eab\u53d7\u8fd9\u77ed\u6682\u7684\u4e00\u751f\u3002\n    <\/div>\n    <p class=\"money\">\u94b1\uff0c\u4e43\u8eab\u5916\u7269\u3002\u4e00\u65e6\u53c2\u900f\u2014\u2014<\/p>\n    <p class=\"final-line\">\u671d<b>\u95fb\u9053<\/b>\uff0c\u5915\u6b7b\u53ef\u77e3\u3002<\/p>\n  <\/div>\n<\/section>\n\n<footer>\n  <span class=\"tg\">\u2637 \u2635 \u2633 \u2632 \u2631 \u2630<\/span>\n  \u9053\u5883 \u00b7 THE SEVENTH REALM\n<\/footer>\n\n<script>\n\/\/ \u6eda\u52a8\u6e10\u663e\nconst io = new IntersectionObserver(es => es.forEach(e => {\n  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }\n}), {threshold:.18});\ndocument.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n\/\/ \u6d6e\u52a8\u7684\u58a8\u5c18\n(function(){\n  const n = 14;\n  for (let i = 0; i < n; i++) {\n    const d = document.createElement('div');\n    d.className = 'dust';\n    const s = 1.5 + Math.random() * 3.5;\n    d.style.cssText = `width:${s}px;height:${s}px;left:${Math.random()*100}vw;\n      top:${100 + Math.random()*20}vh;\n      animation-duration:${18 + Math.random()*20}s;\n      animation-delay:${-Math.random()*30}s`;\n    document.body.appendChild(d);\n  }\n})();\n<\/script>\n<!-- \/wp:html --><\/div>\n<!-- \/wp:column --><\/div>\n<!-- \/wp:columns -->","rendered":"\n<div class=\"wp-block-columns alignfull is-layout-flex wp-container-core-columns-is-layout-794e3cfa wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:100%\">\n<style>\n@import url('https:\/\/fonts.loli.net\/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;600&display=swap');\n\n:root{\n  --white:#ffffff;\n  --ink:#1a1a18;\n  --ink2:#6b675f;\n  --ink-light:rgba(26,26,24,.05);\n  --cinnabar:#b03826;\n  --f-brush:'Ma Shan Zheng','Xingkai SC','STXingkai','KaiTi','STKaiti',serif;\n  --f-body:'Noto Serif SC','Songti SC','STSong','KaiTi','STKaiti',serif;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{\n  background:var(--white);\n  color:var(--ink);\n  font-family:var(--f-body);\n  overflow-x:hidden;\n  line-height:2.1;\n  text-align:center;\n}\n::selection{background:var(--ink);color:#fff}\n\n\/* ---------- \u58a8\u5c18\uff08\u6781\u6de1\uff09 ---------- *\/\n.dust{position:fixed;z-index:-1;border-radius:50%;pointer-events:none;\n  background:radial-gradient(circle, rgba(26,26,24,.16), transparent 70%);\n  animation:drift linear infinite;opacity:0}\n@keyframes drift{\n  0%{transform:translate(0,0);opacity:0}\n  15%{opacity:.35}\n  100%{transform:translate(30px,-108vh) scale(.4);opacity:0}\n}\n\n\/* ---------- \u901a\u7528\uff1a\u5168\u90e8\u5c45\u4e2d ---------- *\/\n.wrap{max-width:840px;margin:0 auto;padding:0 24px}\nsection{padding:88px 24px;position:relative}\n.reveal{opacity:0;transform:translateY(26px);transition:opacity 1.2s ease,transform 1.2s ease}\n.reveal.in{opacity:1;transform:none}\n\n\/* \u6bdb\u7b14\u6a2a\u7ebf\uff08\u975e\u5916\u6846\uff0c\u4ec5\u5206\u9694\uff09 *\/\n.brush{width:min(200px,48%);height:14px;margin:14px auto 38px;display:block}\n.brush path{fill:var(--ink)}\n.trigram{font-size:13px;letter-spacing:15px;padding-left:15px;\n  color:rgba(26,26,24,.3);display:block;margin-bottom:34px}\n\n\/* \u5b57\u53f7\u4f53\u7cfb\uff1a\u6807\u9898\u4e0e\u6b63\u6587\u5dee\u8ddd\u6536\u655b *\/\nh2{font-family:var(--f-brush);font-weight:400;font-size:clamp(27px,3.6vw,34px);letter-spacing:12px;color:var(--ink)}\n\n\/* ---------- \u4e3b\u89c6\u89c9 ---------- *\/\n.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;padding:60px 24px}\n.hero .zi-top{font-size:clamp(14px,2vw,17px);letter-spacing:9px;padding-left:9px;color:var(--ink2);margin-bottom:8px}\n.hero h1{\n  font-family:var(--f-brush);font-weight:400;\n  font-size:clamp(54px,9vw,92px);line-height:1.25;\n  letter-spacing:.08em;text-indent:.08em;color:var(--ink);\n}\n.hero .subtitle{margin-top:14px;font-size:clamp(16px,2.3vw,20px);letter-spacing:10px;color:var(--ink2)}\n.hero .subtitle span{margin:0 10px;opacity:0;animation:fadeUp 1.1s ease forwards}\n.hero .subtitle span:nth-child(1){animation-delay:.4s}\n.hero .subtitle span:nth-child(2){animation-delay:.9s}\n.hero .seal{\n  margin-top:30px;display:inline-block;\n  background:var(--cinnabar);color:#fff;\n  font-family:var(--f-brush);\n  padding:7px 14px;font-size:14px;letter-spacing:6px;border-radius:2px;\n  box-shadow:0 4px 14px rgba(176,56,38,.28);\n  animation:fadeUp 1.1s ease 1.5s forwards;opacity:0\n}\n@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}\n.scroll-hint{\n  display:block;margin-top:52px;\n  font-size:12px;letter-spacing:6px;color:rgba(26,26,24,.35);\n  animation:bob 2.2s ease-in-out infinite\n}\n@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(8px)}}\n\n\/* ---------- \u8bd7\u7bc7\uff1a\u7ad6\u6392\u5c45\u4e2d ---------- *\/\n.vpoem{display:flex;justify-content:center;align-items:flex-start;gap:clamp(20px,4vw,42px)}\n.vpoem p{\n  writing-mode:vertical-rl;\n  font-family:var(--f-brush);\n  font-size:clamp(19px,2.8vw,25px);letter-spacing:12px;\n  color:var(--ink);line-height:1\n}\n.vpoem p em{font-style:normal;color:var(--cinnabar)}\n.verse .ghost{\n  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;\n  font-family:var(--f-brush);\n  font-size:clamp(150px,24vw,280px);color:var(--ink-light);\n  pointer-events:none;user-select:none;z-index:-1\n}\n.book-tag{\n  display:inline-block;margin-bottom:32px;\n  font-family:var(--f-brush);\n  font-size:clamp(22px,3vw,28px);letter-spacing:12px;padding-left:12px;color:var(--ink)\n}\n\n@media(max-width:640px){\n  .vpoem{flex-direction:column;align-items:center;gap:4px}\n  .vpoem p{writing-mode:horizontal-tb;letter-spacing:6px;line-height:2.1}\n}\n\n\/* ---------- \u4e09\u91ca\uff1a\u5c45\u4e2d\u4e09\u67f1 ---------- *\/\n.sanshi{display:flex;justify-content:center;align-items:flex-start;gap:clamp(36px,9vw,100px);margin-top:26px}\n.sanshi .col{display:flex;flex-direction:column;align-items:center;gap:18px}\n.sanshi .zi{\n  width:72px;height:72px;display:flex;align-items:center;justify-content:center;\n  font-family:var(--f-brush);font-size:42px;color:#fff;\n  background:var(--ink);border-radius:4px;\n  box-shadow:0 8px 22px rgba(26,26,24,.22)\n}\n.sanshi .col.red .zi{background:var(--cinnabar);box-shadow:0 8px 22px rgba(176,56,38,.26)}\n.sanshi .desc{font-size:clamp(17px,2.3vw,20px);letter-spacing:6px;color:var(--ink)}\n.sanshi .en{font-size:12px;letter-spacing:2px;color:var(--ink2)}\n@media(max-width:640px){\n  .sanshi{flex-direction:column;align-items:center;gap:40px}\n}\n\n\/* ---------- \u72ec\u53e5 ---------- *\/\n.lone{font-family:var(--f-brush);font-size:clamp(26px,3.8vw,36px);letter-spacing:10px;line-height:2}\n.lone em{font-style:normal;color:var(--cinnabar)}\n\n\/* ---------- \u5b8f\u6587 ---------- *\/\n.prose{max-width:680px;margin:0 auto}\n.prose p{font-size:clamp(17px,2.4vw,20px);letter-spacing:3px;margin:22px 0;color:var(--ink)}\n.prose strong{color:var(--cinnabar);font-weight:600}\n\n\/* ---------- \u7ec8\u7ae0\uff1a\u65e0\u5916\u6846\uff0c\u7559\u767d\u5c45\u4e2d ---------- *\/\n.finale{padding:24px 0 10px}\n.finale .list{font-size:clamp(17px,2.5vw,21px);letter-spacing:4px;line-height:2.6}\n.finale .money{margin-top:18px;color:var(--ink2);font-size:clamp(15px,2.2vw,18px);letter-spacing:4px}\n.final-line{\n  margin-top:30px;font-family:var(--f-brush);\n  font-size:clamp(30px,4.5vw,42px);letter-spacing:10px;color:var(--ink)\n}\n.final-line b{font-weight:400;color:var(--cinnabar)}\n\nfooter{padding:70px 24px 60px;text-align:center;font-size:13px;letter-spacing:4px;color:var(--ink2)}\nfooter .tg{letter-spacing:14px;display:block;margin-bottom:12px;color:rgba(26,26,24,.35)}\n<\/style>\n\n<header class=\"hero\">\n  <p class=\"zi-top\">\u9053 \u751f \u4e00 \u00b7 \u4e00 \u751f \u4e8c \u00b7 \u4e8c \u751f \u4e09 \u00b7 \u4e09 \u751f \u4e07 \u7269<\/p>\n  <h1>\u9053\u5883<\/h1>\n  <p class=\"subtitle\"><span>\u5929\u9053\u916c\u52e4<\/span><span>\u9053\u6cd5\u81ea\u7136<\/span><\/p>\n  <div><span class=\"seal\">\u4e03\u5883\u4e4b\u5370<\/span><\/div>\n  <span class=\"scroll-hint\">\u5c55 \u5377<\/span>\n<\/header>\n\n<section class=\"verse reveal\">\n  <span class=\"trigram\">\u2630 \u2631 \u2632 \u2633 \u2634 \u2635 \u2636 \u2637<\/span>\n  <div class=\"vpoem\">\n    <p>\u9053\u82e5\u4e0d\u540c\uff0c\u4e0d\u76f8\u4e3a\u8c0b\u3002<\/p>\n    <p>\u4e03\u5883\u4e4b\u5185\uff0c\u7686\u4e3a\u543e\u8f88\u3002<\/p>\n    <p>\u4e03\u5883\u4e4b\u5916\uff0c\u540c\u4ec7\u654c\u5ffe\u3002<\/p>\n  <\/div>\n  <span class=\"ghost\">\u9053<\/span>\n<\/section>\n\n<section class=\"verse reveal\">\n  <div class=\"book-tag\">\u5723\u7ecf<\/div>\n  <div class=\"vpoem\">\n    <p>\u795e\u4e0d\u7231\u4e16\u4eba\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u7231<\/em>\u3002<\/p>\n    <p>\u795e\u4e0d\u60af\u4e16\u4eba\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u601c<\/em>\u3002<\/p>\n    <p>\u795e\u4e0d\u5b58\u5f53\u4e16\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u4fe1<\/em>\u3002<\/p>\n    <p>\u795e\u975e\u6551\u4e16\u4e3b\uff0c\u4e16\u4eba\u5e94<em>\u81ea\u6551<\/em>\u3002<\/p>\n  <\/div>\n  <span class=\"ghost\">\u795e<\/span>\n<\/section>\n\n<section class=\"reveal\">\n  <h2>\u4e09\u91ca<\/h2>\n  <svg class=\"brush\" viewBox=\"0 0 200 14\" preserveAspectRatio=\"none\" aria-hidden=\"true\">\n    <path d=\"M3 8 C 26 5, 52 11, 84 8 C 126 4, 160 10, 197 7 C 168 12, 126 14, 92 11 C 58 9, 26 12, 3 8 Z\"\/>\n  <\/svg>\n  <div class=\"sanshi\">\n    <div class=\"col\">\n      <div class=\"zi\">\u9053<\/div>\n      <p class=\"desc\">\u662f\u81ea\u7136\u4e4b\u6cd5<\/p>\n      <span class=\"en\">THE LAW OF NATURE<\/span>\n    <\/div>\n    <div class=\"col\">\n      <div class=\"zi\">\u6cd5<\/div>\n      <p class=\"desc\">\u662f\u9053\u5fb7\u4e4b\u7ebf<\/p>\n      <span class=\"en\">THE THREAD OF VIRTUE<\/span>\n    <\/div>\n    <div class=\"col red\">\n      <div class=\"zi\">\u795e<\/div>\n      <p class=\"desc\">\u662f\u65e0\u77e5\u4e4b\u4ef0<\/p>\n      <span class=\"en\">THE FAITH OF IGNORANCE<\/span>\n    <\/div>\n  <\/div>\n<\/section>\n\n<section class=\"reveal\">\n  <span class=\"trigram\">\u2630 \u2631 \u2632 \u2633 \u2634 \u2635 \u2636 \u2637<\/span>\n  <p class=\"lone\">\u89c1\u5929\u5730\uff0c\u89c1\u4f17\u751f\uff0c<br>\u552f<em>\u4e0d\u89c1\u795e\u8ff9<\/em>\u3002<\/p>\n<\/section>\n\n<section class=\"reveal\">\n  <div class=\"prose\">\n    <p>\u534e\u590f\u4e94\u5343\u5e74\u6587\u660e\u751f\u751f\u4e0d\u606f\uff0c\u5168\u9760\u4f17\u751f\u3002\u4ece\u65e0\u795e\u663e\u2014\u2014\u751f\u6b7b\u6709\u547d\uff0c\u4eba\u5b9a\u80dc\u5929\uff1b\u5929\u9053\u8f6e\u56de\uff0c\u6b7b\u800c\u590d\u751f\uff0c\u4e0d\u751f\u4e0d\u706d\uff0c\u662f\u4e3a<strong>\u6c38\u751f<\/strong>\u3002<\/p>\n    <p>\u6545\u800c\u6c38\u751f\u4e4b\u6cd5\u4e0d\u5728\u8089\u8eab\uff0c\u5728<strong>\u6587\u660e\u4e4b\u7075\u7684\u4f20\u627f<\/strong>\u3002\u89c9\u9192\u4e4b\u65e5\uff0c\u4fbf\u662f\u609f\u9053\u4e4b\u65f6\u3002<\/p>\n  <\/div>\n<\/section>\n\n<section class=\"reveal\">\n  <div class=\"finale\">\n    <div class=\"list\">\n      \u597d\u597d\u6d3b\u7740\uff0c\u597d\u597d\u594b\u6597\uff0c\u597d\u597d\u604b\u7231\uff0c<br>\n      \u597d\u597d\u751f\u80b2\uff0c\u597d\u597d\u6559\u80b2\u4e0b\u4e00\u4ee3\uff0c<br>\n      \u597d\u597d\u4f20\u627f\uff0c\u597d\u597d\u4eab\u53d7\u8fd9\u77ed\u6682\u7684\u4e00\u751f\u3002\n    <\/div>\n    <p class=\"money\">\u94b1\uff0c\u4e43\u8eab\u5916\u7269\u3002\u4e00\u65e6\u53c2\u900f\u2014\u2014<\/p>\n    <p class=\"final-line\">\u671d<b>\u95fb\u9053<\/b>\uff0c\u5915\u6b7b\u53ef\u77e3\u3002<\/p>\n  <\/div>\n<\/section>\n\n<footer>\n  <span class=\"tg\">\u2637 \u2635 \u2633 \u2632 \u2631 \u2630<\/span>\n  \u9053\u5883 \u00b7 THE SEVENTH REALM\n<\/footer>\n\n<script>\n\/\/ \u6eda\u52a8\u6e10\u663e\nconst io = new IntersectionObserver(es => es.forEach(e => {\n  if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }\n}), {threshold:.18});\ndocument.querySelectorAll('.reveal').forEach(el => io.observe(el));\n\n\/\/ \u6d6e\u52a8\u7684\u58a8\u5c18\n(function(){\n  const n = 14;\n  for (let i = 0; i < n; i++) {\n    const d = document.createElement('div');\n    d.className = 'dust';\n    const s = 1.5 + Math.random() * 3.5;\n    d.style.cssText = `width:${s}px;height:${s}px;left:${Math.random()*100}vw;\n      top:${100 + Math.random()*20}vh;\n      animation-duration:${18 + Math.random()*20}s;\n      animation-delay:${-Math.random()*30}s`;\n    document.body.appendChild(d);\n  }\n})();\n<\/script>\n<\/div>\n<\/div>\n","protected":false,"block_version":1}}