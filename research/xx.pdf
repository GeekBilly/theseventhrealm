    let currentLang = 'en';

    function setLanguage(lang) {
      if (!translations[lang]) lang = 'en';
      currentLang = lang;
      document.documentElement.lang = currentLang;

      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (translations[currentLang][key]) {
          el.textContent = translations[currentLang][key];
        }
      });

      document.getElementById('lang-select').value = currentLang;
      document.title = translations[currentLang].title + " | ASCDC";
    }

    function initLang() {
      const saved = localStorage.getItem('app_lang');
      if (saved && translations[saved]) {
        setLanguage(saved);
        return;
      }
      const userLang = navigator.language || navigator.userLanguage;
      const lower = userLang.toLowerCase();

      if (lower.startsWith('zh')) {
        if (lower.includes('tw') || lower.includes('hk') || lower.includes('hant') || lower.includes('mo')) {
          setLanguage('zh-TW');
        } else {
          setLanguage('zh-CN');
        }
      } else {
        const base = lower.split('-')[0];
        setLanguage(translations[base] ? base : 'en');
      }
    }

    document.getElementById('lang-select').addEventListener('change', (e) => {
      const lang = e.target.value;
      localStorage.setItem('app_lang', lang);
      setLanguage(lang);
    });

    const themeToggle = document.getElementById('theme-toggle');
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('app_theme', theme);
    }

    themeToggle.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      setTheme(current === 'dark' ? 'light' : 'dark');
    });

    function initTheme() {
      const saved = localStorage.getItem('app_theme');
      if (saved) {
        setTheme(saved);
      } else {
        const wantsDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(wantsDark ? 'dark' : 'light');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      initLang();
      initTheme();

      const emailLink = document.getElementById('email-link');
      if (emailLink) {
        const ccEmails = 'chen21019@as.edu.tw,as0210259@as.edu.tw,michaelsu@as.edu.tw';
        const hostname = window.location.hostname || '網站';
        const pageTitle = document.title || '';

        function setMailto(clientIP) {
          const ipTag = clientIP ? `[${clientIP}]` : '';
          const subject = `[${hostname}]${ipTag} ${pageTitle}`;
          emailLink.href = `mailto:sawang@gate.sinica.edu.tw?cc=${ccEmails}&subject=${encodeURIComponent(subject)}`;
        }

        // 方案1: HAProxy X-Client-IP response header (最可靠)
        function getIPFromHeader() {
          return new Promise(resolve => {
            const xhr = new XMLHttpRequest();
            xhr.open('HEAD', window.location.href, true);
            xhr.onload = () => resolve(xhr.getResponseHeader('X-Client-IP') || '');
            xhr.onerror = () => resolve('');
            xhr.timeout = 2000;
            xhr.ontimeout = () => resolve('');
            xhr.send();
          });
        }

        // 方案2: 外部 API fallback
        function getIPFromAPI() {
          return fetch('https://api.ipify.org?format=text', { signal: AbortSignal.timeout(3000) })
            .then(r => r.ok ? r.text() : '')
            .catch(() => '');
        }

        // 依序嘗試: header → API → 無 IP
        getIPFromHeader().then(ip => {
          if (ip) { setMailto(ip); return; }
          return getIPFromAPI().then(ip2 => setMailto(ip2));
        }).catch(() => setMailto(''));

        // 先設預設值（無 IP），非同步完成後覆寫
        setMailto('');
      }
    });
  </script>
</body>

